# Salin file ini menjadi .env dan isi dengan API Key Google Gemini Anda
# PENTING: Kunci ini hanya digunakan di sisi server. Jangan pernah melakukan commit file .env ke Git!
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini yang digunakan server (dikonfigurasi secara eksplisit sesuai kuota & akun tim: gemini-3.8-flash / gemini-2.5-flash)
GEMINI_MODEL=gemini-3.8-flash
